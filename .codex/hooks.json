{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/AI_round2/.aether-hooks/pre_compact_brief.py",
            "timeout": 10,
            "statusMessage": "Surfacing substrate brief"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python D:/AI_round2/.aether-hooks/inject_substrate_context.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python D:/AI_round2/.aether-hooks/stop_auto_ingest.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
