{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRT Runtime Config v1",
  "description": "Runtime policy/config surface for CRT. This schema is strict by default to keep config changes intentional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_mode",
    "generation_stack",
    "learned_suggestions",
    "provenance",
    "reflection",
    "training_loop",
    "conflict_warning",
    "assistant_profile",
    "user_named_reference",
    "onboarding"
  ],
  "properties": {
    "background_jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "jobs_db_path",
        "artifacts_dir",
        "worker_interval_seconds",
        "idle_scheduler_enabled",
        "idle_seconds",
        "auto_resolve_contradictions_enabled",
        "auto_web_research_enabled"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "jobs_db_path": { "type": "string", "minLength": 1 },
        "artifacts_dir": { "type": "string", "minLength": 1 },
        "worker_interval_seconds": { "type": "integer", "minimum": 1 },
        "idle_scheduler_enabled": { "type": "boolean" },
        "idle_seconds": { "type": "integer", "minimum": 5 },
        "auto_resolve_contradictions_enabled": { "type": "boolean" },
        "auto_web_research_enabled": { "type": "boolean" },
        "auto_learning_enabled": { "type": "boolean" }
      }
    },
    "agent_tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "default_allow", "global_max_calls_per_run", "tools"],
      "properties": {
        "enabled": { "type": "boolean" },
        "default_allow": { "type": "boolean" },
        "global_max_calls_per_run": { "type": "integer", "minimum": 1 },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "require_approval": { "type": "boolean" },
              "max_calls_per_run": { "type": ["integer", "null"], "minimum": 1 },
              "allowed_channels": {
                "type": "array",
                "items": { "type": "string" }
              },
              "denied_channels": {
                "type": "array",
                "items": { "type": "string" }
              },
              "allowed_users": {
                "type": "array",
                "items": { "type": "string" }
              },
              "denied_users": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "greeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "style": { 
          "type": "string", 
          "enum": ["time_based", "time_of_day", "simple"],
          "default": "time_based"
        },
        "min_absence_for_greeting": { 
          "type": "integer", 
          "minimum": 0,
          "default": 3600
        },
        "templates": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "properties": {
            "new_user": { "type": "string" },
            "returning_minutes": { "type": "string" },
            "returning_hours": { "type": "string" },
            "returning_days": { "type": "string" },
            "returning_weeks": { "type": "string" },
            "morning": { "type": "string" },
            "afternoon": { "type": "string" },
            "evening": { "type": "string" },
            "night": { "type": "string" }
          }
        }
      }
    },
    "response_variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "window_size": { 
          "type": "integer", 
          "minimum": 1,
          "default": 5
        },
        "slot_queries_only": { "type": "boolean", "default": true },
        "slot_templates": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "product_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "memory_authority", "verification_authority", "observability_authority"],
      "properties": {
        "mode": { "type": "string", "enum": ["local_only", "hybrid_verified"] },
        "memory_authority": { "type": "string", "enum": ["local"] },
        "verification_authority": { "type": "string", "enum": ["local"] },
        "observability_authority": { "type": "string", "enum": ["local"] }
      }
    },
    "generation_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "cloud", "routing"],
      "properties": {
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "default_model"],
          "properties": {
            "enabled": { "type": "boolean" },
            "default_model": { "type": "string", "minLength": 1 }
          }
        },
        "cloud": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "provider",
            "model",
            "base_url",
            "api_key_env",
            "timeout_seconds",
            "redact_memory_metadata",
            "max_context_chars",
            "allowed_channels",
            "denied_channels",
            "fact_allowlist",
            "slot_denylist"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": { "type": "string", "enum": ["openai_compatible"] },
            "model": { "type": "string", "minLength": 1 },
            "base_url": { "type": "string", "minLength": 1 },
            "api_key_env": { "type": "string", "minLength": 1 },
            "timeout_seconds": { "type": "number", "minimum": 1 },
            "redact_memory_metadata": { "type": "boolean" },
            "max_context_chars": { "type": "integer", "minimum": 256 },
            "allowed_channels": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "denied_channels": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "fact_allowlist": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "slot_denylist": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cloud_routes", "min_tokens_for_cloud"],
          "properties": {
            "cloud_routes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["fast", "reasoning", "research", "code", "creative"]
              }
            },
            "min_tokens_for_cloud": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "openclaw_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "agent_id",
        "session_prefix",
        "timeout_seconds",
        "allowed_channels",
        "denied_channels",
        "inject_crt_context",
        "include_api_guide",
        "max_fact_items",
        "auto_keywords"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "agent_id": { "type": "string", "minLength": 1 },
        "session_prefix": { "type": "string", "minLength": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 10 },
        "allowed_channels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "denied_channels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inject_crt_context": { "type": "boolean" },
        "include_api_guide": { "type": "boolean" },
        "max_fact_items": { "type": "integer", "minimum": 1 },
        "auto_keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "learned_suggestions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "emit_metadata",
        "emit_ab",
        "print_in_stress_test",
        "write_jsonl",
        "jsonl_include_full_answer"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "emit_metadata": { "type": "boolean" },
        "emit_ab": { "type": "boolean" },
        "print_in_stress_test": { "type": "boolean" },
        "write_jsonl": { "type": "boolean" },
        "jsonl_include_full_answer": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "world_check"],
      "properties": {
        "enabled": { "type": "boolean" },
        "world_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "max_tokens"],
          "properties": {
            "enabled": { "type": "boolean" },
            "max_tokens": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts_dir", "out_model_path", "min_examples", "max_runs"],
      "properties": {
        "artifacts_dir": { "type": "string", "minLength": 1 },
        "out_model_path": { "type": "string", "minLength": 1 },
        "min_examples": { "type": "integer", "minimum": 0 },
        "max_runs": { "type": "integer", "minimum": 0 }
      }
    },
    "journal_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_mode",
        "apply_to_self_text",
        "enforce_authentic_self_reflection",
        "allowed_future_styles"
      ],
      "properties": {
        "style_mode": {
          "type": "string",
          "enum": ["reddit_thread", "structured_notes", "compact_reflection"]
        },
        "apply_to_self_text": { "type": "boolean" },
        "enforce_authentic_self_reflection": { "type": "boolean" },
        "allowed_future_styles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "training_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "source",
        "thread_id",
        "interval_seconds",
        "run_on_startup",
        "min_train_examples",
        "min_eval_examples",
        "min_eval_accuracy",
        "max_prefer_latest_rate"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "source": { "type": "string", "enum": ["thread", "artifacts"] },
        "thread_id": { "type": "string", "minLength": 1 },
        "interval_seconds": { "type": "integer", "minimum": 5 },
        "run_on_startup": { "type": "boolean" },
        "min_train_examples": { "type": "integer", "minimum": 0 },
        "min_eval_examples": { "type": "integer", "minimum": 0 },
        "min_eval_accuracy": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "max_prefer_latest_rate": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "dnnt_retraining": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "poll_interval_seconds",
        "poll_interval_sec",
        "min_new_examples",
        "max_examples_per_cycle",
        "max_steps_per_cycle",
        "batch_size",
        "learning_rate",
        "output_dir",
        "collected_examples_path",
        "collapse_trails_db_path",
        "active_learning_db_path",
        "state_path"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "poll_interval_seconds": { "type": "number", "minimum": 30 },
        "poll_interval_sec": { "type": "integer", "minimum": 10 },
        "min_new_examples": { "type": "integer", "minimum": 0 },
        "max_examples_per_cycle": { "type": "integer", "minimum": 1 },
        "max_steps_per_cycle": { "type": "integer", "minimum": 1 },
        "batch_size": { "type": "integer", "minimum": 1 },
        "learning_rate": { "type": "number", "exclusiveMinimum": 0 },
        "output_dir": { "type": "string", "minLength": 1 },
        "collected_examples_path": { "type": "string", "minLength": 1 },
        "collapse_trails_db_path": { "type": "string", "minLength": 1 },
        "active_learning_db_path": { "type": "string", "minLength": 1 },
        "state_path": { "type": "string", "minLength": 1 }
      }
    },
    "conflict_warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "assistant_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "responses"],
      "properties": {
        "enabled": { "type": "boolean" },
        "responses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "occupation",
            "purpose",
            "identity",
            "background_general",
            "background_filmmaking"
          ],
          "properties": {
            "occupation": { "type": "string" },
            "purpose": { "type": "string" },
            "identity": { "type": "string" },
            "background_general": { "type": "string" },
            "background_filmmaking": { "type": "string" }
          }
        }
      }
    },
    "user_named_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "responses"],
      "properties": {
        "enabled": { "type": "boolean" },
        "responses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known_work_prefix", "ask_to_store", "unknown"],
          "properties": {
            "known_work_prefix": { "type": "string" },
            "ask_to_store": { "type": "string" },
            "unknown": { "type": "string" }
          }
        }
      }
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "auto_run_when_memory_empty", "questions"],
      "properties": {
        "enabled": { "type": "boolean" },
        "auto_run_when_memory_empty": { "type": "boolean" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "kind", "prompt"],
            "properties": {
              "slot": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["fact", "pref"] },
              "prompt": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
