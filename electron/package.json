{
  "name": "aether-desktop",
  "version": "0.1.0",
  "description": "Aether — resident AI intelligence powered by CRT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-context-menu": "^4.1.2",
    "electron-store": "^8.2.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "wrangler": "^4.79.0"
  },
  "build": {
    "appId": "com.aeteros.aether",
    "productName": "Aether",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
