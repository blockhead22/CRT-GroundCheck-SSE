{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRT Agentic Eval Run v1",
  "type": "object",
  "required": [
    "run_id",
    "started_at_utc",
    "finished_at_utc",
    "campaigns",
    "turns_total",
    "hard_fail",
    "hard_fail_reasons",
    "verdict",
    "score",
    "model_selection",
    "groundcheck_lane"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "started_at_utc": { "type": "string", "minLength": 1 },
    "finished_at_utc": { "type": "string", "minLength": 1 },
    "campaigns": { "type": "integer", "minimum": 1 },
    "turns_total": { "type": "integer", "minimum": 0 },
    "hard_fail": { "type": "boolean" },
    "hard_fail_reasons": { "type": "array", "items": { "type": "string" } },
    "verdict": { "type": "string", "enum": ["PASS", "WARN", "FAIL_SOFT", "FAILED_HARD"] },
    "score": {
      "type": "object",
      "required": [
        "contradiction_lifecycle",
        "grounding_faithfulness",
        "isolation_resilience",
        "injection_resilience",
        "operational_stability",
        "total"
      ],
      "properties": {
        "contradiction_lifecycle": { "type": "number" },
        "grounding_faithfulness": { "type": "number" },
        "isolation_resilience": { "type": "number" },
        "injection_resilience": { "type": "number" },
        "operational_stability": { "type": "number" },
        "total": { "type": "number" }
      },
      "additionalProperties": true
    },
    "model_selection": { "type": "object" },
    "groundcheck_lane": { "type": "object" }
  },
  "additionalProperties": true
}
