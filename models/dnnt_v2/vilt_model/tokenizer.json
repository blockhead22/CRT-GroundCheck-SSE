{
  "tokenizer_type": "sentencepiece",
  "vocab_size": 8000,
  "model_file": "tokenizer_sentencepiece.model",
  "special_tokens": {
    "<pad>": 0,
    "<bos>": 3,
    "<eos>": 3,
    "<unk>": 3,
    "<query>": 4,
    "</query>": 5,
    "<facts>": 6,
    "</facts>": 7,
    "<think>": 8,
    "</think>": 9,
    "<response>": 10,
    "</response>": 11
  },
  "extra_tokens": {},
  "char_to_id": {
    "<": 4000,
    "u": 4001,
    "n": 4002,
    "k": 4003,
    ">": 4004,
    "a": 4005,
    "m": 4006,
    "e": 4007,
    "=": 4008,
    "N": 4009,
    "i": 4010,
    "c": 4011,
    "o": 4012,
    "f": 4013,
    "-": 4014,
    "G": 4015,
    "r": 4016,
    "d": 4017,
    "C": 4018,
    "h": 4019,
    "S": 4020,
    "E": 4021
  }
}