                                         {
                                             "slot":  "employer",
                                             "kind":  "fact",
                                             "prompt":  "Who do you work for? (optional)"
                                         },
                                         {
                                             "slot":  "location",
                                             "kind":  "fact",
                                             "prompt":  "Where are you located? (optional)"
                                         },
                                         {
                                             "slot":  "communication_style",
                                             "kind":  "pref",
